{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nuxt: client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Nuxt: server (bun run dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Nuxt: full-stack",
      "configurations": ["Nuxt: server (bun run dev)", "Nuxt: client (Chrome)"],
      "stopAll": true
    }
  ]
}
