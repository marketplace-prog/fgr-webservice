{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build",
      "type": "shell",
      "command": "bun run build",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "bun run typecheck",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "bun run lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "supabase: gerar tipos",
      "type": "shell",
      "command": "bunx supabase gen types typescript --project-id ${input:supabaseProjectRef} > shared/types/database.types.ts",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "supabaseProjectRef",
      "type": "promptString",
      "description": "Project ref do Supabase (Settings > General)"
    }
  ]
}
